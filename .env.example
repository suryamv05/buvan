ENVIRONMENT=development
POSTGRES_DB=valorant
POSTGRES_BOOTSTRAP_USER=postgres_admin
POSTGRES_BOOTSTRAP_PASSWORD=REPLACE_WITH_64_HEX_CHAR_SECRET
APP_DB_USER=valorant_app
APP_DB_PASSWORD=REPLACE_WITH_DIFFERENT_64_HEX_CHAR_SECRET
REDIS_PASSWORD=REPLACE_WITH_DIFFERENT_64_HEX_CHAR_SECRET
RABBITMQ_USER=valorant_worker
RABBITMQ_PASSWORD=REPLACE_WITH_DIFFERENT_64_HEX_CHAR_SECRET
MINIO_ROOT_USER=valorant_silo_admin
MINIO_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_64_HEX_CHAR_SECRET
JWT_SECRET=REPLACE_WITH_DIFFERENT_64_HEX_CHAR_SECRET
REALTIME_JWT_SECRET=REPLACE_WITH_DIFFERENT_64_HEX_CHAR_SECRET
JWT_ISSUER=valorant-api
JWT_AUDIENCE=valorant-client
REALTIME_ISSUER=valorant-api
REALTIME_AUDIENCE=valorant-realtime
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1,api
ENABLE_DOCS=true
MAX_REQUEST_BYTES=1048576
RATE_LIMIT_ENABLED=true
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
OAUTH_REDIRECT_ALLOWLIST=
